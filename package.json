{
  "name": "mr-on",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx src/demo.ts",
    "test:ui": "playwright test",
    "format:check": "prettier --check src public tests skills .github \"docs/**/*.md\" README.md playwright.config.ts package.json package-lock.json tsconfig.json",
    "check:browser": "node --check public/app.js && node --check public/profile.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@sinclair/typebox": "^0.34.41",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
